{
	"AWSTemplateFormatVersion": "2010-09-09",
	"Description": "A sample template",
	"Resources": {
		"User0": {
			"Type": "AWS::IAM::User",
			"Properties": {
				"Groups": [
					{
						"Ref": "Group2"
					}
				]
			}
		},
		"User1": {
			"Type": "AWS::IAM::User",
			"Properties": {
				"Groups": [
					{
						"Ref": "Group2"
					}
				]
			}
		},
		"Group2": {
			"Type": "AWS::IAM::Group",
			"Properties": {
				"ManagedPolicyArns": [
					{
						"Ref": "ManagedPolicy3"
					}
				]
			}
		},
		"ManagedPolicy3": {
			"Type": "AWS::IAM::ManagedPolicy",
			"Properties": {
				"PolicyDocument": {
					"Version": "2012-10-17",
					"Statement": [
						{
							"Sid": "line3",
							"Effect": "Allow",
							"Action": [
								"ec2:StartInstances"
							],
							"Resource": "arn:aws:ec2:us-east-1:221418973682:instance/i-00288e4b16b90626b"
						}
					]
				}
			}
		},
		"Role6": {
			"Type": "AWS::IAM::Role",
			"Properties": {
				"AssumeRolePolicyDocument": {
					"Version": "2012-10-17",
					"Statement": [
						{
							"Effect": "Allow",
							"Principal": {
								"Service": [
									"ec2.amazonaws.com"
								]
							},
							"Action": [
								"sts:AssumeRole"
							]
						}
					]
				},
				"ManagedPolicyArns": [
					{
						"Ref": "ManagedPolicy7"
					}
				]
			}
		},
		"ManagedPolicy7": {
			"Type": "AWS::IAM::ManagedPolicy",
			"Properties": {
				"PolicyDocument": {
					"Version": "2012-10-17",
					"Statement": []
				}
			}
		},
		"User8": {
			"Type": "AWS::IAM::User",
			"Properties": {
				"ManagedPolicyArns": [
					{
						"Ref": "ManagedPolicy7"
					}
				]
			}
		}
	}
}